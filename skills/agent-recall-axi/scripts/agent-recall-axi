#!/usr/bin/env bash
# Runs the bundled CLI: `scripts/agent-recall-axi <command>`. Bash, not node. Follows symlinks to
# itself first, so a link to this file on PATH still finds the sibling agent-recall-axi.mjs.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(CDPATH= cd -P -- "$(dirname -- "$src")" && pwd)"
  src="$(readlink -- "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
dir="$(CDPATH= cd -P -- "$(dirname -- "$src")" && pwd)"
if ! command -v node >/dev/null 2>&1; then
  echo "agent-recall-axi: node 22 or newer is required, and no node is on PATH" >&2
  exit 127
fi
version="$(node --version 2>/dev/null)"
major="${version#v}"
major="${major%%.*}"
case "$major" in '' | *[!0-9]*) major=0 ;; esac
if [ "$major" -lt 22 ]; then
  echo "agent-recall-axi: node 22 or newer is required (found ${version:-an unknown version})" >&2
  exit 1
fi
exec node "$dir/agent-recall-axi.mjs" "$@"
